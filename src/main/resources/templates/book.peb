{% extends "base.peb" %}

{% block title %}{{ books[0].title }} by {{ books[0].author }}{% endblock %}

{% block content %}
<h2>{{ books[0].title }} by {{ books[0].author }}</h2>

<div class="book-details">
    <img src="https://covers.openlibrary.org/b/isbn/{{ books[0].isbn13 }}-M.jpg" alt="Cover" onerror="this.src='/static/no-cover.png'">

    <table>
        <tr>
            <th>Title</th>
            <td>{{ books[0].title }}</td>
        </tr>
        <tr>
            <th>Author</th>
            <td>{{ books[0].author }}</td>
        </tr>
        <tr>
            <th>ISBN</th>
            <td>{{ books[0].isbn13 }}</td>
        </tr>
        <tr>
            <th>Format</th>
            <td>{{ books[0].formatCode }}</td>
        </tr>
        <tr>
            <th>Copies</th>
            <td>{{ books | length }}</td>
        </tr>
        <tr>
            <th>Availability</th>
            <td>
                <ul>
                {% for book in books %}
                    <li>{{ book.locationCode }} —
                        {% if book.isAvailable %}
                            Available
                            {% if loggedIn %}
                            <form method="post" action="/borrow/{{ book.id }}">
                                <button type="submit">Borrow</button>
                            </form> 
                            {% endif %}
                        {% else %}
                            Unavailable
                            {% if isAdmin %}
                            <form method="post" action="/admin/return/{{ book.id }}">
                                <button type="submit">Mark as Returned</button>
                            </form>
                            {% endif %}
                        {% endif %}
                    </li>
                {% endfor %}
                </ul>
                {% if loggedIn %}
                    {% if alreadyReserved %}
                        <button disabled>Already Reserved</button>
                    {% else %}
                    <form method="post" action="/reserve/{{ books[0].isbn13 }}">
                        <button type="submit">Reserve a Copy</button>
                    </form>
                    {% endif %}
                {% endif %}
            </td>
        </tr>
        <tr>
            <th>Notes</th>
            <td>{{ books[0].notes }}</td>
        </tr>
    </table>
</div>

{% endblock %}